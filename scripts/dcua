#!/usr/bin/env bash

# Directories to search for docker-compose.yml files
DIRECTORIES=("/root/homelab-stacks/development" "/root/homelab-stacks/docfile-mgmt" "/root/homelab-stacks/media-mgmt" "/root/homelab-stacks/misc" "/root/homelab-stacks/monitoring" "/root/homelab-stacks/netsec" "/root/homelab-stacks/web-services")  # Add your directories here
ENV_DIR=/root/homelab-stacks/.env

# Loop through each directory
for DIR in "${DIRECTORIES[@]}"; do
    if [ -f "$DIR/compose.yaml" ]; then
        echo "Processing $DIR/compose.yaml"

        # Update services
        docker compose -f "$DIR/compose.yaml" --env-file $ENV_DIR up -d
    else
        echo "No compose.yaml found in $DIR"
    fi
done
