#!/usr/bin/env bash

# Directories to search for docker-compose.yml files
DIRECTORIES=("/root/compose-hub/development" "/root/compose-hub/docfile-mgmt" "/root/compose-hub/media-mgmt" "/root/compose-hub/misc" "/root/compose-hub/monitoring" "/root/compose-hub/netsec" "/root/compose-hub/web-services")  # Add your directories here
ENV_DIR=/root/compose-hub/.env

# Loop through each directory
for DIR in "${DIRECTORIES[@]}"; do
    if [ -f "$DIR/compose.yaml" ]; then
        echo "Processing $DIR/compose.yaml"

        # Update services
        docker compose -f "$DIR/compose.yaml" --env-file $ENV_DIR up -d
    else
        echo "No compose.yaml found in $DIR"
    fi
done
